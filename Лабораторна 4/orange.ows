		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01o\x00\x00\x00^\x00\x00\x04\x90\x00\x00\x03\x17\x00\x00\x01p\x00\x00\x00|\x00\x00\x04\x8f\x00\x00\x03\x16\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00|\x00\x00\x04\x8f\x00\x00\x03\x16', 'scriptLibrary': [], 'scriptText': 'import numpy as np, pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\nfrom statsmodels.tsa.seasonal import seasonal_decompose, STL\n\ndf = table_to_frame(in_data, include_metas=True)\n\ntcol = next((c for c in df.columns if np.issubdtype(df[c].dtype, np.datetime64)), None)\nif tcol is None:\n    tcol = in_data.time_variable.name\n    df[tcol] = pd.to_datetime(df[tcol], unit="s")\nvcol = next(c for c in df.columns if c != tcol and np.issubdtype(df[c].dtype, np.number))\n\ns = df.set_index(tcol)[vcol].astype(float).sort_index().asfreq("MS")\n\ncl  = seasonal_decompose(s, model="additive", period=12)   \nstl = STL(s, period=12, robust=False).fit()               \n\nres = pd.DataFrame({\n    "date":             s.index,\n    "price":            s.values,\n    "seasonal_classic": cl.seasonal.values,\n    "price_sa_classic": (s - cl.seasonal).values,\n    "seasonal_stl":     stl.seasonal.values,\n    "price_sa_stl":     (s - stl.seasonal).values,\n})\nout_data = table_from_frame(res)\nprint(res.round(2).to_string())\nprint("амплітуда сезонності: classic", round(cl.seasonal.max() - cl.seasonal.min(), 2),\n      "| STL", round(stl.seasonal.max() - stl.seasonal.min(), 2))', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
